{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "worker": "bun run --watch src/worker.ts",
    "start": "bun run src/index.ts",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:migrate:deploy": "bunx --bun prisma migrate deploy",
    "db:push": "bunx --bun prisma db push",
    "db:generate": "bunx --bun prisma generate",
    "prisma:studio": "bunx --bun prisma studio",
    "db:reset": "bunx --bun prisma migrate reset",
    "db:seed": "bun run ./prisma/seed.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/express": "^5.0.5",
    "@types/pg": "^8.20.0",
    "eslint": "^10.8.1",
    "nodemon": "^3.1.0",
    "prettier": "^3.9.6",
    "prisma": "^7.8.0",
    "typescript-eslint": "^8.67.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "prisma": {
    "seed": "bun ./prisma/seed.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.3",
    "@langchain/groq": "^1.3.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "argon2": "^0.45.1",
    "bullmq": "^5.80.9",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "ioredis": "^5.11.1",
    "jose": "^6.2.9",
    "langsmith": "^0.8.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rate-limit-redis": "^6.0.1",
    "zod": "^4.4.3"
  }
}
