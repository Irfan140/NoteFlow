generator client {
  provider   = "prisma-client-js"
  output     = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  refreshToken String?
  notes        Note[]
  createdAt    DateTime @default(now())
}

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String?
  summary   String?
  userId    String // foreign key
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}
